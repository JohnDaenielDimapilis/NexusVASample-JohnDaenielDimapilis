{
  "name": "nexus-va-workspace",
  "private": true,
  "version": "1.3.4-9",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development --host 127.0.0.1",
    "start:local": "powershell.exe -NoProfile -File scripts/start-local.ps1",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build --mode production",
    "build:dev": "npm run typecheck && vite build --mode development",
    "preview": "vite preview --mode production --host 127.0.0.1 --port 4173 --strictPort",
    "preview:dev": "vite preview --mode development --host 127.0.0.1 --port 4174 --strictPort",
    "test": "vitest run",
    "check": "npm test && npm run build:dev",
    "format": "prettier --write src tests config index.html vite.config.ts tsconfig.json package.json README.md CHANGELOG.md docs/WORKFLOW.md .github/**/*.yml .github/**/*.md supabase/functions/**/*.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.5"
  },
  "displayVersion": "1.3.4.9"
}
