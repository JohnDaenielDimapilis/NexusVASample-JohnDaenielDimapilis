# Copy to .env.production.local when preparing a production build.
# Use a SEPARATE Supabase project from development. Never use test accounts
# or a service-role/secret key here. These values are public browser config.
VITE_DATA_MODE=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Production builds stop until both connection values are supplied.
# Payments are still simulated in Prototype 1, including production mode.
