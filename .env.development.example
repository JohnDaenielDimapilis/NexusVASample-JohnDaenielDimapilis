# Copy to .env.development.local. This file contains no credentials.
# The browser-local prototype works without any Supabase account.
VITE_DATA_MODE=demo
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# To test real accounts, change DATA_MODE to supabase and fill both values
# using a DEVELOPMENT Supabase project and its public anon/publishable key.
